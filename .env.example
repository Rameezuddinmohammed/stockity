# ---- server (apps/server) ----
DATABASE_URL=postgres://quad:quad@localhost:5432/quad
REDIS_URL=redis://localhost:6379
# Long random string; used to hash OTP codes and blocked emails. `openssl rand -hex 32`
APP_SECRET=change-me-to-a-long-random-string
# Public origin of the web app (used for the CSRF origin check and email links)
APP_ORIGIN=http://localhost:3000
PORT=4000
# Set to true in production behind Caddy so rate limits see the real client IP (X-Forwarded-For)
TRUST_PROXY=false
# Comma-separated emails that get the admin role when they sign in
ADMIN_EMAILS=
# Email delivery: "console" (prints codes to the server log) or "resend"
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=Quad <hello@example.com>

# ---- web (apps/web) ----
# Where Next.js proxies /api/* in development
API_URL=http://localhost:4000

# ---- video calls (optional in development) ----
# Without TURN, calls connect directly (fine on localhost). In production set all three.
TURN_SECRET=
TURN_URLS=
STUN_URLS=
