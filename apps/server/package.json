{
  "name": "@quad/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed-universities.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/websocket": "11.3.1",
    "@quad/shared": "workspace:*",
    "disposable-email-domains": "1.0.62",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "obscenity": "0.4.6",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.11",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "5.0.2",
    "ws": "8.21.3"
  }
}
