# Copy to .env.production on the server (never commit the real file).

# Your domain once you have one. Before DNS exists use ":80" and APP_ORIGIN=http://<server-ip>
DOMAIN=:80
APP_ORIGIN=http://203.0.113.10

# openssl rand -hex 32
APP_SECRET=
# openssl rand -hex 24
POSTGRES_PASSWORD=

ADMIN_EMAILS=you@youruniversity.edu

# Email: "console" logs codes (testing only). Use "resend" for real users.
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=Quad <hello@your-domain>

# Video calls: TURN relay (coturn). PUBLIC_IP is the server's public IPv4;
# TURN_HOST is what browsers connect to (the IP now, e.g. turn.your-domain later).
PUBLIC_IP=203.0.113.10
TURN_HOST=203.0.113.10
# openssl rand -hex 32
TURN_SECRET=

# Optional offsite backups to Cloudflare R2 (leave RCLONE_REMOTE empty to keep backups on the VPS only)
RCLONE_REMOTE=
# RCLONE_REMOTE=r2:quad-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
