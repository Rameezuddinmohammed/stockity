{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "env": ["TEST_DATABASE_URL", "TEST_REDIS_URL"] },
    "dev": { "cache": false, "persistent": true }
  }
}
